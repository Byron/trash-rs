+#[cfg(all(test, not(feature = "trash")))]
+mod trash_disabled_regression {
+    use super::*;
+
+    #[tokio::test]
+    async fn disabled_trash_preserves_file() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("keep.flac");
+        std::fs::write(&path, b"keep these bytes").unwrap();
+        let db_path = dir.path().join("test.db");
+        let state = Arc::new(AppState {
+            db: Database::open(&db_path).unwrap(),
+            db_path,
+            scan_status: Mutex::new(ScanStatus::default()),
+            dupes: Mutex::new(vec![DuplicateGroup {
+                id: "group".into(),
+                files: vec![matcher::DuplicateFile {
+                    path: path.clone(),
+                    duration_secs: 1.0,
+                    match_kind: MatchKind::ExactCopy,
+                }],
+                similarity: 1.0,
+            }]),
+        });
+        let result = api_action(
+            State(state.clone()),
+            Json(ActionRequest {
+                group_id: "group".into(),
+                action: "delete".into(),
+                file_index: 0,
+            }),
+        )
+        .await;
+        assert!(
+            matches!(result, Err((StatusCode::NOT_IMPLEMENTED, _))),
+            "{result:?}"
+        );
+        assert_eq!(std::fs::read(&path).unwrap(), b"keep these bytes");
+        assert!(matches!(
+            restore_from_trash(path.to_str().unwrap()),
+            Err((StatusCode::NOT_IMPLEMENTED, _))
+        ));
+        let result = api_action(
+            State(state),
+            Json(ActionRequest {
+                group_id: "group".into(),
+                action: "exclude".into(),
+                file_index: 0,
+            }),
+        )
+        .await
+        .unwrap();
+        assert_eq!(result.0["status"], "excluded");
+        assert_eq!(std::fs::read(&path).unwrap(), b"keep these bytes");
+    }
+}
